DATABASE_URL=sqlite:///./sap_copilot.db
OPENAI_API_KEY=
OPENAI_BRD_MODEL=gpt-5.6-terra
OPENAI_REQUIREMENTS_MODEL=gpt-5.6-luna
OPENAI_FSD_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_SECONDS=180
OPENAI_BRD_TIMEOUT_SECONDS=240
OPENAI_BRD_MAX_RETRIES=1
OPENAI_BRD_MAX_OUTPUT_TOKENS=24000
OPENAI_BRD_USE_FILE_INPUT=true
OPENAI_BRD_REASONING_EFFORT=low
OPENAI_REQUIREMENTS_MAX_OUTPUT_TOKENS=12000
OPENAI_REQUIREMENTS_BATCH_CHARACTERS=12000
OPENAI_REQUIREMENTS_MAX_BATCHES=50
OPENAI_REQUIREMENTS_PARALLEL_BATCHES=5
OPENAI_FSD_MAX_OUTPUT_TOKENS=24000
OPENAI_FSD_TIMEOUT_SECONDS=120
OPENAI_FSD_MAX_RETRIES=1
ARTIFACT_DIR=generated
OPENAI_MAX_SOURCE_CHARACTERS=500000
CORS_ORIGINS=http://localhost:3000

# Jira Cloud Integration (Free Tier)
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=GP
